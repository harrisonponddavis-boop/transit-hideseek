# Copy this file to `.env` (same folder) and paste your two Google keys.
# The server loads .env automatically on start. Never commit the real .env.

# Server-side key: powers the AI hider's real Street View PHOTOS.
# Needs the "Street View Static API" enabled. Keep this one secret.
GOOGLE_MAPS_KEY=

# Browser key: powers the in-app walk-around Street View + map.
# Needs "Maps Embed API" + "Maps JavaScript API" enabled.
# This one is sent to the browser, so restrict it to your domain in Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=
